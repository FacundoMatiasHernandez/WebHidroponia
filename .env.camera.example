# Copy to .env.camera.local. Replace this example IP with the camera's current IP.
CAMERA_MJPEG_URL=http://192.168.15.12:81/stream
CAMERA_LABEL=ESP32-CAM OV3660
CAMERA_ANALYSIS_FLASH_INTENSITY=0
# More compression than the server default (8), without reducing QXGA resolution.
# This profile recovered captures after FB-OVF errors on the current camera.
CAMERA_STILL_QUALITY=12
CAMERA_ANALYSIS_JPEG_QUALITY=12
# Optional tablet simulator mode: no analysis flash, neutral contrast, separate history.
# CAMERA_CAPTURE_TARGET=screen
